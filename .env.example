# MySQL 连接配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password

# 业务数据库：保存报销记录
MYSQL_DATABASE=enterprise_assistant

# 会话数据库：保存 LangGraph 检查点
MYSQL_MEMORY_DATABASE=enterprise_assistant_memory

# LangSmith 运行追踪，默认关闭
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=enterprise-assistant
LANGSMITH_AGENT_ENVIRONMENT=local